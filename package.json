{
  "name": "edades-del-peru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Edades del Perú — Peruvian history RTS (Caral to present) in Three.js",
  "license": "MIT",
  "author": "Miguel Amaya <miguel.amaya99@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseamaya/edades-del-peru.git"
  },
  "homepage": "https://github.com/joseamaya/edades-del-peru#readme",
  "bugs": {
    "url": "https://github.com/joseamaya/edades-del-peru/issues"
  },
  "keywords": [
    "rts",
    "three.js",
    "typescript",
    "vite",
    "peru",
    "history",
    "game",
    "age-of-empires"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.config.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.ts\" \"*.config.{ts,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:fast": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:fast": "playwright test --project=fast",
    "test:e2e:slow": "playwright test --project=slow",
    "bench": "node scripts/bench.mjs",
    "models:build": "node scripts/build_caral_worker.mjs --out=src/assets/models/caral_worker.glb",
    "build:caral-heightmap": "python3 scripts/build_caral_heightmap.py",
    "bench:check": "node scripts/bench.mjs --scenario=rigs --units=4,12,24,48 --runs=1 --steps=300 --assert --out=review/bench-rigs.json && node scripts/bench.mjs --scenario=fauna --animals=4,8,12,16 --runs=1 --steps=300 --assert --out=review/bench-fauna.json && node scripts/bench.mjs --scenario=mixed-rigs --units=12,24,48 --animals=8 --runs=1 --steps=300 --assert --out=review/bench-mixed-rigs.json",
    "sim": "node scripts/sim.mjs",
    "diagnose:resources": "node scripts/diagnose-resources.mjs",
    "shot": "node scripts/screenshot.mjs",
    "shot:analyze": "node scripts/analyze.mjs",
    "shot:ascii": "node scripts/ascii.mjs",
    "shots:eras": "node scripts/shots_eras.mjs",
    "shots:bld": "node scripts/shots_bld.mjs",
    "shots:close": "node scripts/shots_close.mjs",
    "shots:work": "node scripts/shots_work.mjs",
    "shots:civs": "node scripts/shots_civs.mjs",
    "shots:periods": "node scripts/shots_periods.mjs",
    "shots:media": "node scripts/shots_media.mjs",
    "gif": "node scripts/gif.mjs",
    "package:itch": "node scripts/package_itch.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "visual:check": "node scripts/visual.mjs",
    "art:blender": "tsx scripts/art/cli.ts blender",
    "art:validate": "tsx scripts/art/cli.ts validate",
    "art:review": "tsx scripts/art/cli.ts review"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.185.3",
    "eslint": "^10.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
